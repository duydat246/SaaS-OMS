# Sao chép file này thành .env trên VPS rồi điền giá trị thật. Không commit .env.

# Docker Hub
DOCKERHUB_USERNAME=

# MySQL
DB_USERNAME=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Bảo mật
JWT_SECRET=
# Khoá ký URL ảnh (HMAC). Bắt buộc ở production; nếu để trống sẽ dùng JWT_SECRET.
APP_MEDIA_SECRET=

# Ứng dụng
APP_CORS_ALLOWED_ORIGINS=https://app.darlynstore.com
# Thư mục lưu ảnh trong container backend (đã mount volume uploads).
APP_MEDIA_DIR=/app/uploads
