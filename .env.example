# Sao chép file này thành .env trên VPS rồi điền giá trị thật. Không commit .env.

# Docker Hub
DOCKERHUB_USERNAME=
# Tuỳ chọn: tag image (commit SHA) để rollback. Bỏ trống thì dùng latest.
# Deploy từ CI luôn ghi đè bằng SHA của commit đang deploy.
# IMAGE_TAG=

# MySQL
DB_USERNAME=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Bảo mật
JWT_SECRET=
# Khoá ký URL ảnh (HMAC). Bắt buộc ở production: để trống thì docker compose báo lỗi, không dùng JWT_SECRET thay thế.
APP_MEDIA_SECRET=

# Ứng dụng
APP_CORS_ALLOWED_ORIGINS=https://app.darlynstore.com
# Thư mục lưu ảnh trong container backend (đã mount volume uploads).
APP_MEDIA_DIR=/app/uploads
